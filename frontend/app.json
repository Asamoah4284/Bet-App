{
  "expo": {
    "name": "Quibet",
    "slug": "quibet",
    "scheme": "quibet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-native.png",
      "resizeMode": "cover",
      "backgroundColor": "#F4F6F9"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E3A5F",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/images/app-icon.png"
    },
    "extra": {
      "API_URL": "http://10.68.134.163:3000"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F6F9",
          "image": "./assets/images/splash-native.png",
          "imageWidth": 400,
          "resizeMode": "cover",
          "dark": {
            "backgroundColor": "#14161A",
            "image": "./assets/images/splash-native-dark.png"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#1E3A5F"
        }
      ],
      "expo-font",
      "@react-native-google-signin/google-signin"
    ]
  }
}
