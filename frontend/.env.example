# Optional override. Leave unset in Expo Go — the app auto-uses Metro host:3000 in __DEV__.
# Only set this if you need a fixed LAN IP (As-market style), e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Production / release builds use app.json extra.API_URL (Render).

# --- Google Sign-In (native builds only; not Expo Go) ---
# Web OAuth client ID from Google Cloud Console (type: Web application).
# The SDK uses this so idToken.aud matches what the backend verifies.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional iOS OAuth client ID (type: iOS, bundle com.betapp.recovery).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional — reversed iOS client ID for the Google Sign-In URL scheme, e.g.
# com.googleusercontent.apps.1234567890-abcdefg
# Required for a clean iOS Google handoff after a native rebuild.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
